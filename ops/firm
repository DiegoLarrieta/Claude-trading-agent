#!/bin/bash
# Manual control over the firm's daemons — the human override that always wins.
#   ops/firm up      start watcher + telegram NOW (they still self-exit after close)
#   ops/firm down    stop everything immediately and disable scheduled starts
#   ops/firm on      re-enable the market-hours schedule (undo 'down')
#   ops/firm status  what's running, heartbeat freshness, gateway state
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
AGENTS_DIR="$HOME/Library/LaunchAgents"
SERVICES=(watcher telegram heartbeat)

case "${1:-status}" in
  up)
    for svc in "${SERVICES[@]}"; do
      launchctl load "$AGENTS_DIR/com.trade-agent.$svc.plist" 2>/dev/null || true
    done
    launchctl start com.trade-agent.watcher
    launchctl start com.trade-agent.telegram
    echo "firm is up (daemons still self-exit after the close)"
    ;;
  gateway)
    APP=$(ls -d "/Applications/IB Gateway"*.app "$HOME/Applications/IB Gateway"*/"IB Gateway"*.app 2>/dev/null | grep -v Uninstaller | head -1 || true)
    if [ -z "$APP" ]; then
      echo "IB Gateway app not found in /Applications or ~/Applications" >&2
      exit 1
    fi
    if "$ROOT/.venv/bin/python" "$ROOT/scanner/broker.py" check >/dev/null 2>&1; then
      echo "gateway already up and listening"
      exit 0
    fi
    open "$APP"
    echo "IB Gateway launched — log in (paper mode), then verify with: ops/firm status"
    ;;
  down)
    for svc in "${SERVICES[@]}"; do
      launchctl unload "$AGENTS_DIR/com.trade-agent.$svc.plist" 2>/dev/null || true
    done
    echo "firm is down — nothing runs, scheduled starts disabled until 'ops/firm on'"
    ;;
  on)
    for svc in "${SERVICES[@]}"; do
      launchctl load "$AGENTS_DIR/com.trade-agent.$svc.plist" 2>/dev/null || true
    done
    echo "market-hours schedule re-enabled"
    ;;
  status)
    echo "── launchd services ──"
    launchctl list | grep com.trade-agent || echo "(none loaded — firm is down)"
    echo "── processes ──"
    pgrep -fl "scanner/(watcher|telegram_bot|monitor)" || echo "(no daemon processes running)"
    echo "── heartbeat ──"
    if [ -f "$ROOT/journal/.watcher-heartbeat" ]; then
      echo "last beat: $(cat "$ROOT/journal/.watcher-heartbeat")"
    else
      echo "no heartbeat file"
    fi
    echo "── gateway ──"
    "$ROOT/.venv/bin/python" "$ROOT/scanner/broker.py" check || true
    ;;
  *)
    echo "usage: ops/firm up|down|on|status" >&2
    exit 2
    ;;
esac
